{
    "name": "cashflows",
    "version": "0.1.0",
    "private": true,
    "description": "Импорт банковских CSV-выгрузок и дашборд личных финансов",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "tsx watch server/src/index.ts",
        "dev:web": "vite",
        "import:samples": "tsx server/src/scripts/import-samples.ts samples/*.csv",
        "inspect:xlsx": "tsx server/src/scripts/inspect-xlsx.ts",
        "auto-map": "tsx server/src/scripts/auto-map-merchants.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
        "build": "npm run build:server && npm run build:web",
        "build:server": "tsc -p server/tsconfig.json",
        "build:web": "vite build",
        "start": "node server/dist/server/src/index.js"
    },
    "dependencies": {
        "@fastify/multipart": "^9.0.0",
        "@fastify/static": "^8.0.0",
        "better-sqlite3": "^12.0.0",
        "csv-parse": "^5.5.0",
        "fastify": "^5.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "recharts": "^2.15.4",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/better-sqlite3": "^7.6.11",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.1.2",
        "jsdom": "^26.1.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vite": "^6.3.5",
        "vitest": "^3.2.7",
        "xlsx": "^0.18.5"
    }
}